pipeline {

    agent {

        kubernetes {

            defaultContainer 'terraform'

            yaml """

apiVersion: v1
kind: Pod

metadata:
  labels:
    app: jenkins-agent

spec:

  serviceAccountName: jenkins-agent

  securityContext:
    runAsNonRoot: true
    fsGroup: 1000

  containers:

    - name: terraform
      image: hashicorp/terraform:1.8.5
      command:
        - cat
      tty: true

    - name: aws
      image: amazon/aws-cli:2.17.20
      command:
        - cat
      tty: true

    - name: kubectl
      image: bitnami/kubectl:1.30
      command:
        - cat
      tty: true

    - name: helm
      image: alpine/helm:3.15.2
      command:
        - cat
      tty: true

    - name: tfsec
      image: aquasec/tfsec:latest
      command:
        - cat
      tty: true

    - name: checkov
      image: bridgecrew/checkov:latest
      command:
        - cat
      tty: true

    - name: trivy
      image: aquasec/trivy:latest
      command:
        - cat
      tty: true

    - name: conftest
      image: openpolicyagent/conftest:latest
      command:
        - cat
      tty: true

    - name: opa
      image: openpolicyagent/opa:latest
      command:
        - cat
      tty: true

    - name: infracost
      image: infracost/infracost:latest
      command:
        - cat
      tty: true
"""
        }
    }

    options {

        disableConcurrentBuilds()

        buildDiscarder(
            logRotator(
                numToKeepStr: '20'
            )
        )

        timestamps()

        ansiColor('xterm')

        timeout(
            time: 90,
            unit: 'MINUTES'
        )
    }

    environment {

        AWS_REGION = "ap-south-1"

        ENVIRONMENT = "prod"

        TF_IN_AUTOMATION = "true"

        TF_INPUT = "false"

        TF_PLUGIN_CACHE_DIR = ".terraform.d/plugin-cache"

        KUBECONFIG = "${WORKSPACE}/kubeconfig"

        TF_VAR_environment = "prod"

        TF_VAR_aws_region = "ap-south-1"

        INFRACOST_API_KEY = credentials('infracost-api-key')

        SLACK_WEBHOOK = credentials('slack-webhook')

        AWS_ACCESS_KEY_ID = credentials('aws-access-key-id')

        AWS_SECRET_ACCESS_KEY = credentials('aws-secret-access-key')
    }

    stages {

        stage('Checkout Source Code') {

            steps {

                checkout scm

                sh 'git rev-parse --short HEAD'
            }
        }

        stage('Environment Validation') {

            parallel {

                stage('Terraform Version') {

                    steps {

                        container('terraform') {

                            sh 'terraform version'
                        }
                    }
                }

                stage('AWS Validation') {

                    steps {

                        container('aws') {

                            sh '''
                               aws sts get-caller-identity
                            '''
                        }
                    }
                }

                stage('Kubernetes Validation') {

                    steps {

                        container('kubectl') {

                            sh '''
                               kubectl version --client
                            '''
                        }
                    }
                }
            }
        }

        stage('Terraform Initialization') {

            steps {

                container('terraform') {

                    sh '''
                       terraform init \
                       -backend-config=environments/prod/backend.tfvars
                    '''
                }
            }
        }

        stage('Terraform Format Validation') {

            steps {

                container('terraform') {

                    sh '''
                       terraform fmt -recursive -check
                    '''
                }
            }
        }

        stage('Terraform Validate') {

            steps {

                container('terraform') {

                    sh '''
                       terraform validate
                    '''
                }
            }
        }

        stage('Static Security Scanning') {

            parallel {

                stage('TFSec Scan') {

                    steps {

                        container('tfsec') {

                            sh '''
                               tfsec . \
                               --soft-fail=false
                            '''
                        }
                    }
                }

                stage('Checkov Scan') {

                    steps {

                        container('checkov') {

                            sh '''
                               checkov -d . \
                               --framework terraform
                            '''
                        }
                    }
                }

                stage('Trivy Filesystem Scan') {

                    steps {

                        container('trivy') {

                            sh '''
                               trivy fs . \
                               --severity HIGH,CRITICAL
                            '''
                        }
                    }
                }
            }
        }

        stage('Policy As Code Validation') {

            parallel {

                stage('OPA Validation') {

                    steps {

                        container('opa') {

                            sh '''
                               opa eval \
                               --data policies/opa \
                               --input terraform.tfplan \
                               "data"
                            '''
                        }
                    }
                }

                stage('Conftest Validation') {

                    steps {

                        container('conftest') {

                            sh '''
                               conftest test . \
                               --policy policies/conftest
                            '''
                        }
                    }
                }
            }
        }

        stage('Terraform Plan') {

            steps {

                container('terraform') {

                    sh '''
                       terraform plan \
                       -var-file=environments/prod/terraform.tfvars \
                       -out=tfplan
                    '''
                }
            }
        }

        stage('Drift Detection') {

            steps {

                container('terraform') {

                    sh '''
                       terraform plan \
                       -detailed-exitcode \
                       -var-file=environments/prod/terraform.tfvars || true
                    '''
                }
            }
        }

        stage('Infracost Analysis') {

            steps {

                container('infracost') {

                    sh '''
                       infracost breakdown \
                       --path . \
                       --format table
                    '''
                }
            }
        }

        stage('Artifact Integrity Validation') {

            steps {

                sh '''
                   sha256sum tfplan > tfplan.sha256
                '''

                sh '''
                   sha256sum -c tfplan.sha256
                '''
            }
        }

        stage('Manual Approval') {

            when {

                branch 'main'
            }

            steps {

                input message: "Approve Terraform Apply for Production?"
            }
        }

        stage('Terraform Apply') {

            when {

                branch 'main'
            }

            steps {

                container('terraform') {

                    sh '''
                       terraform apply \
                       -auto-approve tfplan
                    '''
                }
            }
        }

        stage('EKS Kubeconfig Setup') {

            steps {

                container('aws') {

                    sh '''
                       aws eks update-kubeconfig \
                       --region ap-south-1 \
                       --name prod-eks-cluster
                    '''
                }
            }
        }

        stage('Helm Validation') {

            steps {

                container('helm') {

                    sh '''
                       helm lint jenkins/
                    '''
                }
            }
        }

        stage('Kubernetes Deployment Validation') {

            steps {

                container('kubectl') {

                    sh '''
                       kubectl get nodes
                    '''

                    sh '''
                       kubectl get pods -A
                    '''
                }
            }
        }

        stage('Post Deployment Security Scan') {

            parallel {

                stage('Kubernetes CIS Benchmark') {

                    steps {

                        container('trivy') {

                            sh '''
                               trivy k8s \
                               --report summary \
                               cluster
                            '''
                        }
                    }
                }

                stage('Image Vulnerability Scan') {

                    steps {

                        container('trivy') {

                            sh '''
                               trivy image \
                               nginx:latest
                            '''
                        }
                    }
                }
            }
        }
    }

    post {

        always {

            archiveArtifacts artifacts: '''
                tfplan,
                tfplan.sha256
            '''

            cleanWs()
        }

        success {

            echo "Pipeline completed successfully"

            sh '''
               curl -X POST \
               -H 'Content-type: application/json' \
               --data '{"text":"SUCCESS: EKS Platform Deployment Completed"}' \
               $SLACK_WEBHOOK
            '''
        }

        failure {

            echo "Pipeline failed"

            sh '''
               curl -X POST \
               -H 'Content-type: application/json' \
               --data '{"text":"FAILED: EKS Platform Deployment Failed"}' \
               $SLACK_WEBHOOK
            '''
        }
    }
}